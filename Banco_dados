SELECT
    TABLE_NAME,
    COLUMN_NAME,
    DATA_TYPE
FROM ALL_TAB_COLUMNS
WHERE TABLE_NAME IN ('PCCLIENT', 'PCPEDC', 'PCPRACA')
  AND COLUMN_NAME LIKE '%COD%'
ORDER BY TABLE_NAME, COLUMN_NAME;



 ----2 DESAFIO
 
 SELECT 
 PRA.CODPRACA,
 PRA.PRACA,
 COUNT ( DISTINCT CLN.CODCLI) AS QUANTIDADE
 FROM PCPRACA PRA
 INNER JOIN 
 pcclient CLN ON CLN.codpraca = PRA.CODPRACA  
 INNER JOIN
 PCPEDC PED ON PED.CODCLI = CLN.CODCLI
 WHERE CLN.DTEXCLUSAO IS NULL AND PED.DTFAT >= ADD_MONTHS (SYSDATE, -6)
 GROUP BY PRA.CODPRACA,PRA.PRACA
 HAVING COUNT ( DISTINCT CLN.CODCLI) >10
 ORDER BY quantidade DESC
 