--24) Dentro da base de dados prodDatabase inclua a tabela Produto com as seguintes
--colunas id int primary key identity, nome varchar(100), valor decimal(10,4)
CREATE TABLE produtos (
idproduto integer not null,
nome varchar (100),
valor numeric (10,4),
constraint pk_prod_idprod PRIMARY KEY (idproduto)
);
--25) Dentro da base de dados prodDatabase inclua a tabela Pedido com as seguintes
--colunas: id int primary key, codigo int, cliente varchar(255) dataCriacao datetime.
CREATE TABLE pedido (
idpedido integer PRIMARY KEY, 
cliente varchar (225),
data_criacao date
);
--26) Dentro da base de dados prodDatabase inclua a tabela PedidoItem com as seguintes
--colunas: idPedido int foreign key references pedido(id), idProduto int foreign key references
--produto(id), quantidade int default 0
CREATE TABLE pedido_item(
idpedido integer not null,
idproduto integer not null, 
quantidade integer default 0, 
constraint fk_peditem_ped foreign key (idpedido)
references pedido (idpedido),
constraint fk_peditem_prod foreign key (idproduto)
references produtos (idproduto)
);
